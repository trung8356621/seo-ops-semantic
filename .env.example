# Application
APP_ENV=local
APP_NAME=seo-ops-semantic
APP_HOST=0.0.0.0
APP_PORT=8088
# Keep at 1 so the embedding model is not duplicated in RAM.
UVICORN_WORKERS=1
LOG_LEVEL=info

# PostgreSQL (semantic infrastructure only — not Laravel business DB)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=semantic
POSTGRES_USER=semantic
POSTGRES_PASSWORD=semantic_local_change_me
# Optional host-side bind for Compose (portable default uses named volume).
# Windows example: POSTGRES_DATA=E:/docker-data/seo-ops-semantic/postgres
POSTGRES_DATA=

# Embedding
EMBEDDING_PROVIDER=onnx_fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Inside the container this is /models. Override host path with SEMANTIC_MODEL_CACHE.
# Host/dev default is a local folder. Compose overrides this to /models in the container.
MODEL_CACHE_DIR=.models
# Windows example: SEMANTIC_MODEL_CACHE=E:/docker-data/seo-ops-semantic/models
SEMANTIC_MODEL_CACHE=

# Startup / readiness
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_SECONDS=2
EMBEDDING_LAZY_LOAD=true

# Topic analysis V1 (cosine-threshold clustering)
TOPIC_CLUSTER_SIMILARITY_THRESHOLD=0.70
TOPIC_MIN_MEMBER_SIMILARITY=0.62
TOPIC_ASSIGNMENT_MIN_SCORE=0.62
TOPIC_MIN_GROUP_SIZE=2
TOPIC_LOW_CONFIDENCE_SCORE=0.35
TOPIC_MAX_KEYWORDS=2000
TOPIC_MAX_TEXT_LENGTH=500
TOPIC_EMBEDDING_CACHE_ENABLED=true
